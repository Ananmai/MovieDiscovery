# Server Configuration
PORT=5000
NODE_ENV=development

# Third-Party Movie API (TMDB)
# Leave blank or set your free API key from https://www.themoviedb.org/settings/api
# The application automatically falls back to an enriched offline dataset if omitted or offline!
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Database & Cache
DATABASE_PATH=./data/movies.db
CACHE_TTL_DEFAULT=600
CACHE_TTL_GENRES=86400
CACHE_TTL_DETAILS=7200

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
